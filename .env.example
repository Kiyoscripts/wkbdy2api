WKB2API_API_KEY=change-me-at-least-16-chars
HOST=127.0.0.1
PORT=7891
LOG_LEVEL=info

# Optional explicit aliases for /v1/messages. Responses report the actual upstream model.
WKB2API_MODEL_ALIASES={}

# Upstream (defaults verified against the WorkBuddy chat protocol)
WKB2API_UPSTREAM_URL=https://www.workbuddy.ai/v2/chat/completions
WKB2API_UPSTREAM_UA=WorkBuddy/2.137.1
WKB2API_FIRST_BYTE_TIMEOUT_MS=60000
WKB2API_IDLE_TIMEOUT_MS=300000

# OAuth account pool persistence. The key file must contain exactly 32 raw bytes
# or their base64 encoding. Keep the key separate from the encrypted data file.
WKB2API_ACCOUNT_STORE_PATH=data/accounts.enc
WKB2API_ACCOUNT_STORE_KEY_FILE=./account-store.key

# Optional local WorkBuddy credential file used only by the admin import endpoint.
# WKB2API_CREDENTIALS_PATH=

# JSONL trace of raw upstream/downstream tool-call frames. Set to an empty
# string to disable. When a client reports broken tool arguments, this file
# shows the exact deltas upstream sent, which distinguishes a parser mismatch
# from streaming truncation from a bad fallback.
WKB2API_TOOL_TRACE_PATH=data/tool-calls.jsonl
