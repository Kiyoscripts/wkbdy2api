{
  "name": "wkbdy2api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible local gateway for WorkBuddy AI (loopback only)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@types/node": "^22.13.5",
    "happy-dom": "20.8.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
